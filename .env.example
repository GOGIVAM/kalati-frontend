# URL de base du backend .NET.
# Laisser vide pour utiliser le proxy Vite (/api -> VITE_PROXY_TARGET).
VITE_API_URL=https://localhost:7285

# Cible du proxy de développement Vite (utilisée seulement si VITE_API_URL est vide).
VITE_PROXY_TARGET=http://localhost:5080

# Transport du JWT : "header" (Authorization: Bearer) ou "cookie" (cookie httpOnly).
VITE_AUTH_TRANSPORT=header

# Langue par défaut de l'interface : fr | en
VITE_DEFAULT_LOCALE=fr

# Seuil de fidélité en dessous duquel l'interface affiche un refus calibré.
VITE_FAITHFULNESS_THRESHOLD=0.90

# Seuil de score de confiance moyen des passages récupérés.
VITE_CONFIDENCE_THRESHOLD=0.60

# Seuils de production RAGAS, affichés à côté de chaque score.
# Le backend reste seul décideur : ces valeurs ne servent qu'à l'affichage.
VITE_ANSWER_RELEVANCY_THRESHOLD=0.85
VITE_CONTEXT_PRECISION_THRESHOLD=0.80
VITE_CONTEXT_RECALL_THRESHOLD=0.80

# Interface vocale (dictée Whisper large-v3 + lecture Coqui TTS côté serveur).
# false pour masquer entièrement le micro et la lecture audio.
VITE_VOICE_ENABLED=true
